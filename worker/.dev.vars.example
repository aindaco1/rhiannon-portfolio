# Copy outside tracked source and replace every value before deployment.
# The Worker has no development authentication bypass.
ADMIN_ORIGIN=https://editor.YOUR-DOMAIN.example
ACCESS_TEAM_DOMAIN=https://YOUR-TEAM.cloudflareaccess.com
ACCESS_AUD=YOUR-ACCESS-APPLICATION-AUDIENCE
# EDITOR_EMAILS is configured in wrangler.jsonc; do not override it here.
GITHUB_OWNER=aindaco1
GITHUB_REPO=YOUR-PRIVATE-PORTFOLIO-REPOSITORY
GITHUB_APP_CLIENT_ID=YOUR-APP-CLIENT-ID
GITHUB_APP_INSTALLATION_ID=YOUR-INSTALLATION-ID
GITHUB_APP_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR-KEY\n-----END PRIVATE KEY-----"
