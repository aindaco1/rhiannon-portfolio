{
  "name": "rhiannon-portfolio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.22.1 <25 || >=26.12.1 <27"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "build:production": "node scripts/build.mjs --production",
    "test": "node --test tests/*.test.mjs",
    "test:docs": "node scripts/check-docs.mjs",
    "test:browser": "playwright test",
    "check": "npm run test:docs && npm test && npm run build && npm run test:browser",
    "check:pin": "node scripts/check-pin.mjs"
  },
  "dependencies": {
    "jose": "6.2.17"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.1",
    "esbuild": "0.28.1",
    "sharp": "0.35.5"
  }
}
